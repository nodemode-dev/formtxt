{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormTxt",
  "version": "0.29.10",
  "identifier": "ai.nodemode.formtxt",
  "build": {
    "devUrl": "http://localhost:5199",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormTxt",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/formtxt-engine"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "category": "Productivity",
    "shortDescription": "Documents",
    "copyright": "Copyright 2026 nodemode-ai.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
