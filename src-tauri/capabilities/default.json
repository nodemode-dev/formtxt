{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window shows the page the engine serves on 127.0.0.1 (or the dev server on localhost), a remote origin to Tauri, so the capability lists those addresses and every app command has an allow permission.",
  "windows": ["splash", "main"],
  "remote": { "urls": ["http://127.0.0.1:*", "http://localhost:*"] },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-set-title",
    "allow-set-window-title",
    "allow-app-ready",
    "allow-text-edit",
    "allow-system-fonts"
  ]
}
