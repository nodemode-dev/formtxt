#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMTXT_ROOT"
for d in frontend/dist src-tauri/target backend/build backend/dist-engine; do rm -rf "$d"; done
find backend -name __pycache__ -type d -prune -exec rm -rf {} +
if [ "${1:-}" = "--all" ]; then
  for d in backend/venv frontend/node_modules; do rm -rf "$d"; done
fi
ft_say "clean"
