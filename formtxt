#!/usr/bin/env bash
set -e
FORMTXT_CALLER_DIR="$PWD"
export FORMTXT_CALLER_DIR
cd "$(dirname "$0")"
usage() {
  printf 'formtxt %s · documents\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'USAGE'

usage: ./formtxt [command] [options]

  (none) | boot       boot the engine (8210) and the frontend (5210) together
  install             install backend and frontend
  backend             boot the engine only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  install-desktop     install PyInstaller and check the Tauri toolchain
  freeze              freeze the engine into the desktop app's sidecar
  desktop dev         run the Tauri desktop shell against the engine
  desktop build       build the window, freeze the engine and bundle the app (./build_app does all of it)
  cli list|describe|run  the editor's command catalogue from a terminal; run <id> [key=value ...] needs the window open
  clean [--all]       remove build output (--all also venv and node_modules)
  icons --check       fail when interface code draws a sparkle icon (banned app-wide)
  help               this text
USAGE
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  backend) cd backend && exec ./boot_backend "$@" ;;
  frontend) cd frontend && exec ./boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  cli) exec python3 setup/catalogue.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  icons) exec python3 -B setup/icon_rules.py ;;
  help|-h|--help) usage ;;
  *) printf '[formtxt] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
